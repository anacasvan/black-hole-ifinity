{
  "name": "black-hole-infinity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/sw.mjs",
    "build:standalone": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
